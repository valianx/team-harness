{
  "description": "Team Harness deterministic-deny safety hooks for POSIX Codex. Native Codex permissions own approval prompts; review/trust is required before these hooks are active.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$PLUGIN_ROOT/hooks/run-codex-hook.sh\" policy-block",
            "timeout": 10,
            "statusMessage": "Checking Team Harness repository policy"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$PLUGIN_ROOT/hooks/run-codex-hook.sh\" gcp-guard",
            "timeout": 10,
            "statusMessage": "Checking catastrophic GCP operations"
          }
        ]
      }
    ]
  }
}
