{
  "format_version": 1,
  "runtime": "codex",
  "max_concurrent_threads_per_session": 4,
  "project_execution": {
    "sandbox_mode": "workspace-write",
    "approval_policy": "on-request",
    "network_access": true,
    "writable_roots": [
      "~/.cache/go-build",
      "~/.cache/uv",
      "~/.npm",
      "~/go/pkg/mod"
    ]
  },
  "project_defaults": {
    "default_subagent_model": "gpt-5.6-terra",
    "default_subagent_reasoning_effort": "medium",
    "features": {
      "multi_agent": true,
      "multi_agent_v2": true
    }
  },
  "allowed_capabilities": [
    "filesystem-read",
    "filesystem-write",
    "command-exec",
    "test-write",
    "external-read",
    "external-write"
  ],
  "allowed_sandbox_modes": ["read-only", "workspace-write"],
  "allowed_source_models": ["opus", "sonnet", "haiku"],
  "allowed_source_efforts": ["medium", "high", "xhigh"],
  "allowed_runtime_reasoning_efforts": ["low", "medium", "high", "xhigh", "max"],
  "projection_tiers": [
    {
      "name": "opus",
      "source_models": ["opus"],
      "source_efforts": ["medium", "high", "xhigh"]
    },
    {
      "name": "sonnet-high",
      "source_models": ["sonnet"],
      "source_efforts": ["high", "xhigh"]
    },
    {
      "name": "sonnet-medium",
      "source_models": ["sonnet"],
      "source_efforts": ["medium"]
    },
    {
      "name": "haiku",
      "source_models": ["haiku"],
      "source_efforts": ["medium", "high", "xhigh"]
    }
  ],
  "default_profile": "team-harness",
  "profiles": {
    "team-harness": {
      "inherit_parent": false,
      "tiers": {
        "opus": {
          "model": "gpt-5.6-sol",
          "reasoning_effort": "xhigh"
        },
        "sonnet-high": {
          "model": "gpt-5.6-terra",
          "reasoning_effort": "high"
        },
        "sonnet-medium": {
          "model": "gpt-5.6-terra",
          "reasoning_effort": "medium"
        },
        "haiku": {
          "model": "gpt-5.6-terra",
          "reasoning_effort": "low"
        }
      }
    }
  },
  "agents": [
    {
      "name": "architect",
      "description": "Designs scoped solutions and produces acceptance-driven work plans.",
      "semantic_source": "agents/architect.md",
      "sandbox_mode": "workspace-write",
      "capabilities": ["filesystem-read", "filesystem-write", "external-read"],
      "instruction_source": "runtime/codex/instructions/architect.md",
      "output_path": ".codex/agents/architect.toml"
    },
    {
      "name": "implementer",
      "description": "Implements one approved task within its declared file scope.",
      "semantic_source": "agents/implementer.md",
      "sandbox_mode": "workspace-write",
      "capabilities": ["filesystem-read", "filesystem-write", "command-exec"],
      "instruction_source": "runtime/codex/instructions/implementer.md",
      "output_path": ".codex/agents/implementer.toml"
    },
    {
      "name": "tester",
      "description": "Authors and runs tests mapped to acceptance criteria.",
      "semantic_source": "agents/tester.md",
      "sandbox_mode": "workspace-write",
      "capabilities": ["filesystem-read", "test-write", "command-exec"],
      "instruction_source": "runtime/codex/instructions/tester.md",
      "output_path": ".codex/agents/tester.toml"
    },
    {
      "name": "qa",
      "description": "Validates delivered behavior against the approved acceptance criteria.",
      "semantic_source": "agents/qa.md",
      "sandbox_mode": "read-only",
      "capabilities": ["filesystem-read", "command-exec"],
      "instruction_source": "runtime/codex/instructions/qa.md",
      "output_path": ".codex/agents/qa.toml"
    },
    {
      "name": "security",
      "description": "Audits changed behavior for concrete security regressions and risks.",
      "semantic_source": "agents/security.md",
      "sandbox_mode": "read-only",
      "capabilities": ["filesystem-read", "command-exec", "external-read"],
      "instruction_source": "runtime/codex/instructions/security.md",
      "output_path": ".codex/agents/security.toml"
    },
    {
      "name": "inline-reviewer",
      "description": "Runs one bounded tester, QA, security, or adversary lens over an anchored project.",
      "semantic_source": "agents/inline-reviewer.md",
      "sandbox_mode": "read-only",
      "capabilities": ["filesystem-read", "command-exec"],
      "capability_profile": "inline-review-read-only",
      "instruction_source": "runtime/codex/instructions/inline-reviewer.md",
      "output_path": ".codex/agents/inline-reviewer.toml"
    },
    {
      "name": "delivery",
      "description": "Prepares release artifacts and delivery evidence after acceptance passes.",
      "semantic_source": "agents/delivery.md",
      "sandbox_mode": "workspace-write",
      "capabilities": ["filesystem-read", "filesystem-write", "command-exec", "external-write"],
      "instruction_source": "runtime/codex/instructions/delivery.md",
      "output_path": ".codex/agents/delivery.toml"
    },
    {
      "name": "reviewer",
      "description": "Reviews an immutable pull-request snapshot for concrete merge blockers and suggestions.",
      "semantic_source": "agents/reviewer.md",
      "sandbox_mode": "read-only",
      "capabilities": ["filesystem-read", "external-read"],
      "capability_profile": "review-read-only",
      "instruction_source": "runtime/codex/instructions/reviewer.md",
      "output_path": ".codex/agents/reviewer.toml"
    },
    {
      "name": "pr-review-qa",
      "description": "Validates acceptance criteria against an immutable pull-request snapshot.",
      "semantic_source": "agents/pr-review-qa.md",
      "sandbox_mode": "read-only",
      "capabilities": ["filesystem-read"],
      "capability_profile": "review-read-only",
      "instruction_source": "runtime/codex/instructions/pr-review-qa.md",
      "output_path": ".codex/agents/pr-review-qa.toml"
    },
    {
      "name": "pr-review-security",
      "description": "Audits an immutable pull-request snapshot for concrete security regressions.",
      "semantic_source": "agents/pr-review-security.md",
      "sandbox_mode": "read-only",
      "capabilities": ["filesystem-read"],
      "capability_profile": "review-read-only",
      "instruction_source": "runtime/codex/instructions/pr-review-security.md",
      "output_path": ".codex/agents/pr-review-security.toml"
    },
    {
      "name": "reviewer-consolidator",
      "description": "Consolidates PR-review lenses into one de-duplicated review draft.",
      "semantic_source": "agents/reviewer-consolidator.md",
      "sandbox_mode": "read-only",
      "capabilities": ["filesystem-read"],
      "capability_profile": "review-read-only",
      "instruction_source": "runtime/codex/instructions/reviewer-consolidator.md",
      "output_path": ".codex/agents/reviewer-consolidator.toml"
    }
  ]
}
