{
  "name": "th-hooks-ts",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "TypeScript context and observability hooks for team-harness",
  "scripts": {
    "build:session-start": "esbuild entry/session-start.cc.ts --bundle --platform=node --format=cjs --outfile=dist/session-start.cjs --external:node:*",
    "build:language-user-prompt": "esbuild entry/language-user-prompt.cc.ts --bundle --platform=node --format=cjs --outfile=dist/language-user-prompt.cjs --external:node:*",
    "build:subagent-trace": "esbuild entry/subagent-trace.cc.ts --bundle --platform=node --format=cjs --outfile=dist/subagent-trace.cjs --external:node:*",
    "build:precompact-snapshot": "esbuild entry/precompact-snapshot.cc.ts --bundle --platform=node --format=cjs --outfile=dist/precompact-snapshot.cjs --external:node:*",
    "build:notify-stage": "esbuild entry/notify-stage.cc.ts --bundle --platform=node --format=cjs --outfile=dist/notify-stage.cjs --external:node:*",
    "build:subagent-start": "esbuild entry/subagent-start.cc.ts --bundle --platform=node --format=cjs --outfile=dist/subagent-start.cjs --external:node:*",
    "build": "npm run build:session-start && npm run build:language-user-prompt && npm run build:subagent-trace && npm run build:precompact-snapshot && npm run build:notify-stage && npm run build:subagent-start && echo 'context and observability builds ok'",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
